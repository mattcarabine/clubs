{
  "name": "clubs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && pnpm run db:migrate:remote && wrangler deploy",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:live": "vitest run --config vitest.live.config.ts",
    "e2e:server": "export CLUBS_E2E=1 && rm -rf .wrangler/e2e && wrangler d1 migrations apply DB --local --env test --persist-to .wrangler/e2e && CLOUDFLARE_ENV=test react-router build && vite preview --strictPort",
    "fixtures:record": "node scripts/record-fixtures.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:generate": "drizzle-kit generate",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.1.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.4.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.11",
    "secretlint": "^13.0.7",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "simple-git-hooks": {
    "pre-commit": "sh scripts/pre-commit.sh",
    "pre-push": "pnpm typecheck && pnpm lint && pnpm test"
  }
}
