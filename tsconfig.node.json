{
  "extends": "./tsconfig.json",
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.live.config.ts",
    "playwright.config.ts",
    "drizzle.config.ts",
    "e2e/**/*",
    "scripts/**/*",
    "live/**/*",
    "app/lib/london-time.ts",
    "app/lib/relative-time.ts",
    "app/ea/**/*",
    "app/poll/rating-targets.ts",
    "app/ai/config.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler"
  }
}
